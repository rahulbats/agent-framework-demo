# --- Foundry control-plane (inherited from ../01-local-agent-dev/.env) ---
# FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Agent Identity (Service Principal) ---
# Created by `python setup_identity.py`, or fill in manually with values
# from `az ad sp create-for-rbac`.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Azure resource the agent reads ---
STORAGE_ACCOUNT=
STORAGE_CONTAINER=policy-docs
STORAGE_BLOB=policy-document.txt

# --- Optional ---
# AGENT_NAME_LAB04=policy-reader-agent
